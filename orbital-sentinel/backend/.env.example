APP_NAME=ORBITAL SENTINEL
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CelesTrak. Multiple URLs separated by commas.
CELESTRAK_URLS=https://celestrak.org/NORAD/elements/gp.php?GROUP=IRIDIUM-33-DEBRIS&FORMAT=JSON,https://celestrak.org/NORAD/elements/gp.php?NAME=COSMOS%202251%20DEB&FORMAT=JSON
CELESTRAK_TIMEOUT_SECONDS=30

# Screening
DEFAULT_WINDOW_HOURS=3
DEFAULT_COARSE_STEP_SECONDS=60
DEFAULT_REFINE_STEP_SECONDS=1
COARSE_BROADPHASE_DISTANCE_KM=1000
HIGH_RISK_DISTANCE_KM=1
MEDIUM_RISK_DISTANCE_KM=5

# LLM explanation (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_MAX_OUTPUT_TOKENS=300
